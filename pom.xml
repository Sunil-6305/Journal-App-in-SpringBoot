	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
				<!-- Spring Boot Starter Data JPA -->
				<dependency>
				    <groupId>org.springframework.boot</groupId>
				    <artifactId>spring-boot-starter-data-jpa</artifactId>
				</dependency>
				<!-- MySQL Connector -->
				<dependency>
				    <groupId>com.mysql</groupId>
				    <artifactId>mysql-connector-j</artifactId>
				</dependency>
				<dependency>
				  <groupId>org.springframework.boot</groupId>
				  <artifactId>spring-boot-devtools</artifactId>
				</dependency>
				
				<!-- pom.xml me ye dependency add karo -->
				<dependency>
				    <groupId>org.projectlombok</groupId>
				    <artifactId>lombok</artifactId>
				     <!-- latest as of 2025 -->
				    <scope>provided</scope>
				</dependency>
				
				<!-- Spring Security --> 
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-security</artifactId>
			</dependency>
				
				<!-- ✅ JWT Dependencies for Token Based Authentication -->
				<!-- JJWT API: Main interface for creating/parsing JWTs -->
				<dependency>
				    <groupId>io.jsonwebtoken</groupId>
				    <artifactId>jjwt-api</artifactId>
				    <version>0.12.5</version>
				</dependency>
				
				<!-- JJWT Implementation: Actual implementation used at runtime -->
				<dependency>
				    <groupId>io.jsonwebtoken</groupId>
				    <artifactId>jjwt-impl</artifactId>
				    <version>0.12.5</version>
				    <scope>runtime</scope>
				</dependency>

			<!-- JJWT with Jackson: JSON support for JWT claims using Jackson -->
			<dependency>
			    <groupId>io.jsonwebtoken</groupId>
			    <artifactId>jjwt-jackson</artifactId>
			    <version>0.12.5</version>
			</dependency>

				<!-- Spring Security google auth & OAuth2 -->
					
					<dependency>
					    <groupId>org.springframework.boot</groupId>
					    <artifactId>spring-boot-starter-oauth2-client</artifactId>
					</dependency>
					
					<!-- JWT ka koi jab alredy hai-->
					   					
				<!-- <dependency>
			    <groupId>com.google.api-client</groupId>
					    <artifactId>google-api-client</artifactId>
					    <version>2.2.0</version>
			    </dependency>-->
			    
			    <dependency>
			    <groupId>com.google.api-client</groupId>
			    <artifactId>google-api-client</artifactId>
			    <version>1.34.1</version>
			      </dependency>

				<!-- .env file se value loa dkarne kliye-->
					   					
					<dependency>
					  <groupId>io.github.cdimascio</groupId>
					  <artifactId>dotenv-java</artifactId>
					  <version>3.0.0</version>
					</dependency>

				
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
